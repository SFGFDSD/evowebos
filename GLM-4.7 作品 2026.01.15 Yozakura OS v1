        // ============================================
        // INITIALIZATION
        // ============================================

        async function init() {
            const bootScreen = document.getElementById('boot-screen');
            const bootLogo = document.querySelector('.boot-logo');
            const bootLoader = document.querySelector('.boot-loader');

            // Hide boot screen after animation completes (even if init fails)
            const hideBootScreen = () => {
                setTimeout(() => {
                    bootScreen.classList.add('hidden');
                    setTimeout(() => {
                        bootScreen.remove();
                    }, 800);
                }, 500);
            };

            try {
                // Initialize file system with timeout
                await Promise.race([
                    initFileSystem(),
                    new Promise((_, reject) => 
                        setTimeout(() => reject(new Error('Init timeout')), 20000)
                    )
                ]);
                
                // Load settings
                await loadSettings();
                
                // Initialize UI components
                initTaskbar();
                initStartMenu();
                initDesktopIcons();
                initContextMenu();
                initFileImport();
                
                // Start clock
                updateClock();
                setInterval(updateClock, 1000);
                
                // Hide boot screen
                hideBootScreen();

                // Handle resize
                window.addEventListener('resize', () => {
                    OS.isMobile = window.innerWidth <= 768;
                });

            } catch (err) {
                console.error('Initialization failed:', err);
                
                // Show error message on boot screen
                if (bootLogo) {
                    bootLogo.innerHTML = '<span style="color:var(--aka)">Initialization Failed</span>';
                }
                if (bootLoader) {
                    bootLoader.style.display = 'none';
                }
                
                // Add retry button
                const retryBtn = document.createElement('button');
                retryBtn.textContent = 'Retry';
                retryBtn.style.cssText = `
                    margin-top: 20px;
                    padding: 10px 24px;
                    background: var(--kin);
                    color: var(--kuro);
                    border: none;
                    border-radius: 8px;
                    cursor: pointer;
                    font-family: inherit;
                    font-size: 1rem;
                `;
                retryBtn.onclick = () => location.reload();
                
                // Clear boot screen and add retry button
                bootScreen.innerHTML = '';
                bootScreen.appendChild(bootLogo);
                bootScreen.appendChild(retryBtn);
            }
        }

        // Wait for DOM to be ready before starting
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            // DOM is already ready
            init();
        }

        // Polyfill for Buffer if needed
        if (typeof Buffer === 'undefined') {
            window.Buffer = {
                from: (data) => {
                    if (ArrayBuffer.isView(data)) {
                        return data;
                    }
                    if (typeof data === 'string') {
                        const encoder = new TextEncoder();
                        return encoder.encode(data);
                    }
                    return new Uint8Array(data);
                }
            };
        }
    </script>

    <input type="file" id="file-import-input" class="hidden-input" multiple>
    <input type="file" id="wallpaper-input" class="hidden-input" accept="image/*">

    <script>
        // ============================================
        // YOZAKURA OS - Virtual File System & Desktop
        // ============================================

        // Buffer polyfill - must be defined before any BrowserFS operations
        if (typeof Buffer === 'undefined') {
            window.Buffer = {
                from: (data) => {
                    if (ArrayBuffer.isView(data)) {
                        return data;
                    }
                    if (typeof data === 'string') {
                        const encoder = new TextEncoder();
                        return encoder.encode(data);
                    }
                    return new Uint8Array(data);
                }
            };
        }

        const OS = {
            fs: null,
            windows: [],
            windowIdCounter: 0,
            activeWindowId: null,
            isMobile: window.innerWidth <= 768,
            
            // Default wallpapers
            wallpapers: [
                'https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?w=1920&q=80',
                'https://images.unsplash.com/photo-1480796927426-f609979314bd?w=1920&q=80',
                'https://images.unsplash.com/photo-1545569341-9eb8b30979d9?w=1920&q=80',
                'https://images.unsplash.com/photo-1518837695005-2083093ee35b?w=1920&q=80'
            ],

            // Apps configuration
            apps: {
                files: {
                    name: 'Files',
                    icon: 'fa-folder-open',
                    iconClass: 'icon-files',
                    width: 800,
                    height: 500
                },
                editor: {
                    name: 'Text Editor',
                    icon: 'fa-file-lines',
                    iconClass: 'icon-editor',
                    width: 700,
                    height: 500
                },
                browser: {
                    name: 'Browser',
                    icon: 'fa-globe',
                    iconClass: 'icon-browser',
                    width: 900,
                    height: 600
                },
                paint: {
                    name: 'Drawing',
                    icon: 'fa-palette',
                    iconClass: 'icon-paint',
                    width: 700,
                    height: 550
                },
                media: {
                    name: 'Media',
                    icon: 'fa-play-circle',
                    iconClass: 'icon-media',
                    width: 600,
                    height: 450
                },
                calculator: {
                    name: 'Calculator',
                    icon: 'fa-calculator',
                    iconClass: 'icon-calc',
                    width: 320,
                    height: 450
                },
                settings: {
                    name: 'Settings',
                    icon: 'fa-gear',
                    iconClass: 'icon-settings',
                    width: 500,
                    height: 450
                }
            }
        };

        // ============================================
        // INDEXEDDB & BROWSERFS INITIALIZATION
        // ============================================

        async function initFileSystem() {
            return new Promise((resolve, reject) => {
                // Add timeout to prevent hanging
                const timeout = setTimeout(() => {
                    console.error('BrowserFS init timeout');
                    reject(new Error('BrowserFS initialization timeout'));
                }, 15000);

                BrowserFS.configure({
                    fs: "IndexedDB",
                    options: {
                        storeName: "yozakura_fs"
                    }
                }, (err) => {
                    clearTimeout(timeout);
                    if (err) {
                        console.error('BrowserFS init failed:', err);
                        reject(err);
                        return;
                    }
                    
                    OS.fs = BrowserFS.BFSRequire('fs');
                    
                    // Initialize file system functions now that fs is ready
                    initFileSystemFunctions();
                    
                    // Initialize default directory structure
                    initDefaultStructure().then(() => {
                        resolve(OS.fs);
                    }).catch(reject);
                });
            });
        }

        async function initDefaultStructure() {
            const dirs = [
                '/home',
                '/home/user',
                '/home/user/Desktop',
                '/home/user/Documents',
                '/home/user/Downloads',
                '/home/user/Pictures',
                '/home/user/Music',
                '/home/user/Videos'
            ];

            // Create directories with error handling
            for (const dir of dirs) {
                try {
                    await ensureDir(dir);
                } catch (err) {
                    console.warn(`Failed to create directory ${dir}:`, err);
                }
            }

            // Create welcome file
            const welcomeContent = `Welcome to 夜櫻 OS (Yozakura OS)
================================

A beautiful, browser-based desktop environment.

Features:
• Persistent file system with IndexedDB
• Built-in applications
• Responsive design for mobile & desktop
• Custom wallpapers

Built with ❤️ using vanilla JavaScript.

Press F11 for fullscreen experience.
`;
            
            try {
                await writeFile('/home/user/Documents/welcome.txt', welcomeContent);
            } catch (err) {
                console.warn('Failed to create welcome file:', err);
            }
            
            // Save current wallpaper index
            try {
                await saveSettings();
            } catch (err) {
                console.warn('Failed to save settings:', err);
            }
        }

        function promisify(fs, method) {
            return function(...args) {
                return new Promise((resolve, reject) => {
                    if (!fs || typeof fs[method] !== 'function') {
                        reject(new Error(`File system not ready or method ${method} not available`));
                        return;
                    }
                    fs[method](...args, (err, result) => {
                        if (err) reject(err);
                        else resolve(result);
                    });
                });
            };
        }

        // File system functions - will be initialized after BrowserFS is ready
        let readdir, readFile, writeFile, mkdir, stat, unlink, rmdir, rename;
        
        function initFileSystemFunctions() {
            readdir = promisify(OS.fs, 'readdir');
            readFile = promisify(OS.fs, 'readFile');
            writeFile = promisify(OS.fs, 'writeFile');
            mkdir = promisify(OS.fs, 'mkdir');
            stat = promisify(OS.fs, 'stat');
            unlink = promisify(OS.fs, 'unlink');
            rmdir = promisify(OS.fs, 'rmdir');
            rename = promisify(OS.fs, 'rename');
        }

        async function ensureDir(path) {
            try {
                await mkdir(path);
            } catch (err) {
                if (err.code !== 'EEXIST') throw err;
            }
        }

        async function pathExists(path) {
            try {
                await stat(path);
                return true;
            } catch {
                return false;
            }
        }

        function pathJoin(...parts) {
            return parts.join('/').replace(/\/+/g, '/');
        }

        function pathDirname(path) {
            return path.substring(0, path.lastIndexOf('/')) || '/';
        }

        function pathBasename(path) {
            return path.substring(path.lastIndexOf('/') + 1);
        }

        // ============================================
        // SETTINGS MANAGEMENT
        // ============================================

        let settings = {
            wallpaperIndex: 0,
            customWallpaper: null
        };

        async function loadSettings() {
            try {
                const data = await readFile('/home/user/.settings');
                settings = JSON.parse(data.toString());
            } catch (err) {
                settings = { wallpaperIndex: 0, customWallpaper: null };
            }
            applyWallpaper();
        }

        async function saveSettings() {
            try {
                await ensureDir('/home/user');
                await writeFile('/home/user/.settings', JSON.stringify(settings));
            } catch (err) {
                console.error('Failed to save settings:', err);
            }
        }

        function applyWallpaper() {
            const desktop = document.getElementById('desktop');
            if (settings.customWallpaper) {
                desktop.style.backgroundImage = `url(${settings.customWallpaper})`;
            } else {
                desktop.style.backgroundImage = `url(${OS.wallpapers[settings.wallpaperIndex] || OS.wallpapers[0]})`;
            }
        }

        // ============================================
        // WINDOW MANAGER
        // ============================================

        function createWindow(appId, title = null, options = {}) {
            const app = OS.apps[appId];
            if (!app) return null;

            const windowId = ++OS.windowIdCounter;
            const isMobile = OS.isMobile;
            
            const width = isMobile ? window.innerWidth : (options.width || app.width);
            const height = isMobile ? window.innerHeight - 56 : (options.height || app.height);
            const left = isMobile ? 0 : Math.max(0, (window.innerWidth - width) / 2 + (Math.random() - 0.5) * 100);
            const top = isMobile ? 0 : Math.max(0, (window.innerHeight - height) / 2 + (Math.random() - 0.5) * 100);

            const windowEl = document.createElement('div');
            windowEl.className = 'window';
            windowEl.id = `window-${windowId}`;
            windowEl.dataset.windowId = windowId;
            windowEl.dataset.appId = appId;
            windowEl.style.cssText = `width:${width}px;height:${height}px;left:${left}px;top:${top}px;z-index:${100 + windowId}`;

            windowEl.innerHTML = `
                <div class="window-titlebar">
                    <div class="window-title">
                        <i class="fa-solid ${app.icon}"></i>
                        <span>${title || app.name}</span>
                    </div>
                    <div class="window-controls">
                        <button class="window-btn minimize" data-action="minimize" title="Minimize">−</button>
                        <button class="window-btn maximize" data-action="maximize" title="Maximize">□</button>
                        <button class="window-btn close" data-action="close" title="Close">×</button>
                    </div>
                </div>
                <div class="window-content" id="window-content-${windowId}"></div>
                ${!isMobile ? `
                <div class="resize-handle s" data-resize="s"></div>
                <div class="resize-handle e" data-resize="e"></div>
                <div class="resize-handle se" data-resize="se"></div>
                ` : ''}
            `;

            document.getElementById('windows-container').appendChild(windowEl);
            
            const windowData = {
                id: windowId,
                appId,
                el: windowEl,
                contentEl: windowEl.querySelector(`#window-content-${windowId}`),
                title,
                isMinimized: false,
                isMaximized: false,
                prevState: { left, top, width, height }
            };

            OS.windows.push(windowData);
            
            // Initialize app content
            initAppContent(appId, windowData, options);

            // Event listeners
            initWindowEvents(windowData);
            
            // Bring to front
            focusWindow(windowId);
            
            // Update taskbar
            updateTaskbar();

            return windowData;
        }

        function initWindowEvents(windowData) {
            const { el } = windowData;

            // Click to focus
            el.addEventListener('mousedown', () => focusWindow(windowData.id));

            // Window controls
            el.querySelectorAll('.window-btn').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const action = btn.dataset.action;
                    if (action === 'minimize') minimizeWindow(windowData.id);
                    else if (action === 'maximize') toggleMaximize(windowData.id);
                    else if (action === 'close') closeWindow(windowData.id);
                });
            });

            // Dragging
            if (!OS.isMobile) {
                const titlebar = el.querySelector('.window-titlebar');
                let isDragging = false;
                let dragOffset = { x: 0, y: 0 };

                titlebar.addEventListener('mousedown', (e) => {
                    if (windowData.isMaximized) return;
                    if (e.target.closest('.window-controls')) return;
                    
                    isDragging = true;
                    dragOffset.x = e.clientX - el.offsetLeft;
                    dragOffset.y = e.clientY - el.offsetTop;
                    titlebar.style.cursor = 'grabbing';
                });

                document.addEventListener('mousemove', (e) => {
                    if (!isDragging) return;
                    
                    let newX = e.clientX - dragOffset.x;
                    let newY = e.clientY - dragOffset.y;
                    
                    // Constrain to viewport
                    newX = Math.max(0, Math.min(newX, window.innerWidth - 50));
                    newY = Math.max(0, Math.min(newY, window.innerHeight - 50));
                    
                    el.style.left = newX + 'px';
                    el.style.top = newY + 'px';
                });

                document.addEventListener('mouseup', () => {
                    isDragging = false;
                    titlebar.style.cursor = 'grab';
                });

                // Resizing
                el.querySelectorAll('.resize-handle').forEach(handle => {
                    handle.addEventListener('mousedown', (e) => {
                        if (windowData.isMaximized) return;
                        e.preventDefault();
                        
                        const resizeType = handle.dataset.resize;
                        const startX = e.clientX;
                        const startY = e.clientY;
                        const startWidth = el.offsetWidth;
                        const startHeight = el.offsetHeight;
                        const startLeft = el.offsetLeft;
                        const startTop = el.offsetTop;

                        const doResize = (e) => {
                            const dx = e.clientX - startX;
                            const dy = e.clientY - startY;

                            if (resizeType.includes('e')) {
                                el.style.width = Math.max(300, startWidth + dx) + 'px';
                            }
                            if (resizeType.includes('s')) {
                                el.style.height = Math.max(200, startHeight + dy) + 'px';
                            }
                        };

                        const stopResize = () => {
                            document.removeEventListener('mousemove', doResize);
                            document.removeEventListener('mouseup', stopResize);
                        };

                        document.addEventListener('mousemove', doResize);
                        document.addEventListener('mouseup', stopResize);
                    });
                });
            }
        }

        function focusWindow(windowId) {
            const windowData = OS.windows.find(w => w.id === windowId);
            if (!windowData) return;

            const maxZ = Math.max(...OS.windows.map(w => parseInt(w.el.style.zIndex) || 100));
            windowData.el.style.zIndex = maxZ + 1;
            OS.activeWindowId = windowId;
            
            // Update taskbar active state
            updateTaskbar();
        }

        function minimizeWindow(windowId) {
            const windowData = OS.windows.find(w => w.id === windowId);
            if (!windowData) return;

            windowData.isMinimized = true;
            windowData.el.classList.add('minimized');
            updateTaskbar();
        }

        function restoreWindow(windowId) {
            const windowData = OS.windows.find(w => w.id === windowId);
            if (!windowData) return;

            windowData.isMinimized = false;
            windowData.el.classList.remove('minimized');
            focusWindow(windowId);
            updateTaskbar();
        }

        function toggleMaximize(windowId) {
            const windowData = OS.windows.find(w => w.id === windowId);
            if (!windowData) return;

            if (windowData.isMaximized) {
                // Restore
                windowData.el.classList.remove('maximized');
                windowData.el.style.left = windowData.prevState.left + 'px';
                windowData.el.style.top = windowData.prevState.top + 'px';
                windowData.el.style.width = windowData.prevState.width + 'px';
                windowData.el.style.height = windowData.prevState.height + 'px';
                windowData.isMaximized = false;
            } else {
                // Maximize
                windowData.prevState = {
                    left: windowData.el.offsetLeft,
                    top: windowData.el.offsetTop,
                    width: windowData.el.offsetWidth,
                    height: windowData.el.offsetHeight
                };
                windowData.el.classList.add('maximized');
                windowData.el.style.left = '0';
                windowData.el.style.top = '0';
                windowData.el.style.width = '100%';
                windowData.el.style.height = '100%';
                windowData.isMaximized = true;
            }
        }

        function closeWindow(windowId) {
            const windowIndex = OS.windows.findIndex(w => w.id === windowId);
            if (windowIndex === -1) return;

            const windowData = OS.windows[windowIndex];
            windowData.el.classList.add('closing');

            setTimeout(() => {
                windowData.el.remove();
                OS.windows.splice(windowIndex, 1);
                if (OS.activeWindowId === windowId) {
                    OS.activeWindowId = OS.windows.length > 0 ? OS.windows[OS.windows.length - 1].id : null;
                }
                updateTaskbar();
            }, 200);
        }

        // ============================================
        // TASKBAR
        // ============================================

        function initTaskbar() {
            const taskbar = document.getElementById('taskbar');
            
            // Start button
            const startBtn = document.createElement('div');
            startBtn.className = 'taskbar-item start-btn';
            startBtn.innerHTML = '<i class="fa-solid fa-torii-gate"></i>';
            startBtn.addEventListener('click', toggleStartMenu);
            taskbar.appendChild(startBtn);

            // Divider
            const divider = document.createElement('div');
            divider.className = 'taskbar-divider';
            taskbar.appendChild(divider);

            // Running apps container

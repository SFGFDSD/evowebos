            // Reset file system
            contentEl.querySelector(`#reset-fs-${id}`).addEventListener('click', async () => {
                if (confirm('Are you sure you want to reset the file system? This will delete all files!')) {
                    try {
                        // Clear IndexedDB
                        indexedDB.deleteDatabase('yozakura_fs');
                        showToast('File system reset. Reloading...');
                        setTimeout(() => location.reload(), 1500);
                    } catch (err) {
                        showToast('Failed to reset file system', 'error');
                    }
                }
            });

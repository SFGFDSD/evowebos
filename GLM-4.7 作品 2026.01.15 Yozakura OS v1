        // ============================================
        // FILE IMPORT HANDLER
        // ============================================

        function initFileImport() {
            const input = document.getElementById('file-import-input');
            if (!input) return;
            
            input.addEventListener('change', async (e) => {
                const files = Array.from(e.target.files);
                if (files.length === 0) return;

                const targetPath = input.dataset.targetPath || '/home/user/Downloads';

                for (const file of files) {
                    try {
                        const buffer = await file.arrayBuffer();
                        await writeFile(`${targetPath}/${file.name}`, Buffer.from(buffer));
                        showToast(`Imported: ${file.name}`);
                    } catch (err) {
                        console.error('Import error:', err);
                        showToast(`Failed to import ${file.name}`, 'error');
                    }
                }

                input.value = '';
                input.dataset.targetPath = '';
                refreshFileExplorers();
            });

            // Wallpaper upload
            const wallpaperInput = document.getElementById('wallpaper-input');
            wallpaperInput.addEventListener('change', async (e) => {
                const file = e.target.files[0];
                if (!file) return;

                const reader = new FileReader();
                reader.onload = async (event) => {
                    settings.customWallpaper = event.target.result;
                    await saveSettings();
                    applyWallpaper();
                    showToast('Wallpaper updated');
                    
                    // Save to VFS
                    try {
                        await writeFile('/home/user/.wallpaper', Buffer.from(new Uint8Array(await file.arrayBuffer())));
                    } catch (err) {
                        console.error('Failed to save wallpaper to VFS:', err);
                    }
                    
                    refreshFileExplorers();
                };
                reader.readAsDataURL(file);
                wallpaperInput.value = '';
            });
        }


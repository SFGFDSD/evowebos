<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>夜櫻 OS | Yozakura OS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=JetBrains+Mono:wght@300;400;500&family=Zen+Kaku+Gothic+New:wght@300;400;500;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/browserfs@2.0.0/dist/browserfs.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            /* Japanese-inspired color palette */
            --kuro: #1a1a1c;
            --shiro: #f0efe9;
            --aka: #c73232;
            --kin: #d4a853;
            --midori: #3d6b4b;
            --hai: #6b6b6b;
            --sora: #2a3b4c;
            --sakura: #f8e1e7;
            --window-bg: rgba(26, 26, 28, 0.92);
            --window-border: rgba(212, 168, 83, 0.3);
            --glass: rgba(255, 255, 255, 0.08);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            font-family: 'Zen Kaku Gothic New', sans-serif;
            overflow: hidden;
            user-select: none;
            background: var(--kuro);
            color: var(--shiro);
        }

        /* Boot screen */
        #boot-screen {
            position: fixed;
            inset: 0;
            background: var(--kuro);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 10000;
            transition: opacity 0.8s ease-out;
        }

        #boot-screen.hidden {
            opacity: 0;
            pointer-events: none;
        }

        .boot-logo {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(2rem, 8vw, 4rem);
            font-weight: 300;
            letter-spacing: 0.5em;
            color: var(--shiro);
            margin-bottom: 2rem;
            animation: fadeInUp 1s ease-out;
        }

        .boot-logo span {
            color: var(--aka);
            font-weight: 600;
        }

        .boot-loader {
            width: 200px;
            height: 2px;
            background: var(--glass);
            border-radius: 2px;
            overflow: hidden;
        }

        .boot-loader-bar {
            height: 100%;
            background: linear-gradient(90deg, var(--aka), var(--kin));
            width: 0%;
            animation: loading 2s ease-out forwards;
        }

        @keyframes loading {
            to { width: 100%; }
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Desktop */
        #desktop {
            position: fixed;
            inset: 0;
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            transition: background-image 0.5s ease;
        }

        #desktop::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(26,26,28,0.3) 0%, rgba(26,26,28,0.6) 100%);
            pointer-events: none;
        }

        /* Desktop icons */
        .desktop-icons {
            position: absolute;
            top: 20px;
            left: 20px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            flex-wrap: wrap;
            align-content: flex-start;
            max-height: calc(100vh - 100px);
            max-width: 100px;
        }

        .desktop-icon {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 12px 8px;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.2s ease;
            width: 80px;
        }

        .desktop-icon:hover {
            background: var(--glass);
            backdrop-filter: blur(10px);
        }

        .desktop-icon:active {
            transform: scale(0.95);
        }

        .desktop-icon i {
            font-size: 2rem;
            margin-bottom: 8px;
            filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));
        }

        .desktop-icon .icon-files { color: var(--kin); }
        .desktop-icon .icon-editor { color: var(--midori); }
        .desktop-icon .icon-browser { color: var(--sora); }
        .desktop-icon .icon-paint { color: var(--aka); }
        .desktop-icon .icon-media { color: #e06c75; }
        .desktop-icon .icon-calc { color: #61afef; }
        .desktop-icon .icon-settings { color: var(--hai); }
        .desktop-icon .icon-folder { color: var(--kin); }

        .desktop-icon span {
            font-size: 0.7rem;
            text-align: center;
            color: var(--shiro);
            text-shadow: 0 1px 3px rgba(0,0,0,0.5);
            word-break: break-word;
            line-height: 1.3;
        }

        /* Window */
        .window {
            position: absolute;
            background: var(--window-bg);
            border: 1px solid var(--window-border);
            border-radius: 16px;
            box-shadow: 
                0 25px 50px -12px rgba(0, 0, 0, 0.5),
                0 0 0 1px rgba(255, 255, 255, 0.05),
                inset 0 1px 0 rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            min-width: 300px;
            min-height: 200px;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            transition: box-shadow 0.2s ease, transform 0.1s ease;
            animation: windowOpen 0.3s ease-out;
        }

        @keyframes windowOpen {
            from {
                opacity: 0;
                transform: scale(0.95);
            }
            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        .window.closing {
            animation: windowClose 0.2s ease-in forwards;
        }

        @keyframes windowClose {
            to {
                opacity: 0;
                transform: scale(0.95);
            }
        }

        .window.minimized {
            display: none;
        }

        .window.maximized {
            border-radius: 0;
            border: none;
        }

        .window-titlebar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 16px;
            background: linear-gradient(180deg, rgba(255,255,255,0.05) 0%, transparent 100%);
            border-bottom: 1px solid var(--glass);
            cursor: grab;
            flex-shrink: 0;
        }

        .window-titlebar:active {
            cursor: grabbing;
        }

        .window-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1rem;
            font-weight: 500;
            letter-spacing: 0.05em;
            color: var(--shiro);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .window-title i {
            color: var(--kin);
            font-size: 0.9rem;
        }

        .window-controls {
            display: flex;
            gap: 8px;
        }

        .window-btn {
            width: 14px;
            height: 14px;
            border-radius: 50%;
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0;
            transition: all 0.2s ease;
        }

        .window-btn:hover {
            transform: scale(1.1);
        }

        .window-btn.minimize {
            background: var(--kin);
        }

        .window-btn.maximize {
            background: var(--midori);
        }

        .window-btn.close {
            background: var(--aka);
        }

        .window-content {
            flex: 1;
            overflow: auto;
            position: relative;
        }

        /* Resize handles */
        .resize-handle {
            position: absolute;
            background: transparent;
        }

        .resize-handle.se {
            right: 0;
            bottom: 0;
            width: 20px;
            height: 20px;
            cursor: se-resize;
        }

        .resize-handle.e {
            right: 0;
            top: 40px;
            width: 6px;
            height: calc(100% - 60px);
            cursor: e-resize;
        }

        .resize-handle.s {
            bottom: 0;
            left: 40px;
            width: calc(100% - 60px);
            height: 6px;
            cursor: s-resize;
        }

        /* Taskbar */
        #taskbar {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            height: 56px;
            background: rgba(26, 26, 28, 0.9);
            backdrop-filter: blur(30px);
            -webkit-backdrop-filter: blur(30px);
            border-top: 1px solid var(--glass);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 16px;
            gap: 8px;
            z-index: 9000;
        }

        .taskbar-item {
            width: 44px;
            height: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.2s ease;
            font-size: 1.2rem;
            position: relative;
        }

        .taskbar-item:hover {
            background: var(--glass);
            transform: translateY(-2px);
        }

        .taskbar-item.active {
            background: var(--glass);
        }

        .taskbar-item.active::after {
            content: '';
            position: absolute;
            bottom: 4px;
            width: 20px;
            height: 3px;
            background: var(--kin);
            border-radius: 2px;
        }

        .taskbar-item.start-btn {
            color: var(--aka);
        }

        .taskbar-divider {
            width: 1px;
            height: 32px;
            background: var(--glass);
            margin: 0 8px;
        }

        /* Start Menu */
        #start-menu {
            position: fixed;
            bottom: 70px;
            left: 50%;
            transform: translateX(-50%) scale(0.95);
            width: 360px;
            max-width: calc(100vw - 32px);
            background: rgba(26, 26, 28, 0.95);
            border: 1px solid var(--window-border);
            border-radius: 20px;
            padding: 20px;
            backdrop-filter: blur(30px);
            -webkit-backdrop-filter: blur(30px);
            opacity: 0;
            pointer-events: none;
            transition: all 0.2s ease;
            z-index: 9000;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }

        #start-menu.open {
            opacity: 1;
            pointer-events: auto;
            transform: translateX(-50%) scale(1);
        }

        .start-menu-header {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.5rem;
            font-weight: 300;
            color: var(--shiro);
            margin-bottom: 20px;
            text-align: center;
            letter-spacing: 0.2em;
        }

        .start-menu-apps {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
        }

        .start-app-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 16px 8px;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .start-app-item:hover {
            background: var(--glass);
        }

        .start-app-item i {
            font-size: 1.5rem;
            margin-bottom: 8px;
        }

        .start-app-item span {
            font-size: 0.65rem;
            color: var(--shiro);
            text-align: center;
        }

        /* Context Menu */
        #context-menu {
            position: fixed;
            background: rgba(26, 26, 28, 0.98);
            border: 1px solid var(--window-border);
            border-radius: 12px;
            padding: 8px 0;
            min-width: 180px;
            backdrop-filter: blur(20px);
            z-index: 10000;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.15s ease;
            box-shadow: 0 10px 40px rgba(0,0,0,0.5);
        }

        #context-menu.open {
            opacity: 1;
            pointer-events: auto;
        }

        .context-item {
            padding: 10px 20px;
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
            font-size: 0.85rem;
            transition: background 0.1s ease;
        }

        .context-item:hover {
            background: var(--glass);
        }

        .context-item i {
            width: 18px;
            color: var(--hai);
        }

        .context-divider {
            height: 1px;
            background: var(--glass);
            margin: 8px 0;
        }

        /* Clock */
        #clock {
            position: fixed;
            bottom: 70px;
            right: 20px;
            text-align: right;
            pointer-events: none;
            z-index: 8000;
        }

        #clock-time {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2.5rem;
            font-weight: 300;
            color: var(--shiro);
            text-shadow: 0 2px 10px rgba(0,0,0,0.3);
            line-height: 1;
        }

        #clock-date {
            font-size: 0.85rem;
            color: var(--hai);
            margin-top: 4px;
        }

        /* App specific styles */
        
        /* File Explorer */
        .file-explorer {
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        .file-toolbar {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 12px 16px;
            border-bottom: 1px solid var(--glass);
            flex-wrap: wrap;
        }

        .file-nav-btn {
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            cursor: pointer;
            color: var(--hai);
            transition: all 0.2s ease;
        }

        .file-nav-btn:hover {
            background: var(--glass);
            color: var(--shiro);
        }

        .file-path {
            flex: 1;
            background: var(--kuro);
            border: 1px solid var(--glass);
            border-radius: 8px;
            padding: 8px 12px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.8rem;
            color: var(--shiro);
            min-width: 0;
        }

        .file-grid {
            flex: 1;
            padding: 16px;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(90px, 1fr));
            gap: 16px;
            align-content: start;
            overflow-y: auto;
        }

        .file-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 12px 8px;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .file-item:hover {
            background: var(--glass);
        }

        .file-item.selected {
            background: rgba(212, 168, 83, 0.2);
            border: 1px solid rgba(212, 168, 83, 0.3);
        }

        .file-item i {
            font-size: 2rem;
            margin-bottom: 8px;
        }

        .file-item i.fa-folder { color: var(--kin); }
        .file-item i.fa-file-lines { color: var(--hai); }
        .file-item i.fa-file-image { color: #c678dd; }
        .file-item i.fa-file-code { color: var(--midori); }
        .file-item i.fa-file-zipper { color: #e5c07b; }
        .file-item i.fa-file-audio { color: #e06c75; }
        .file-item i.fa-file-video { color: #98c379; }

        .file-item span {
            font-size: 0.7rem;
            text-align: center;
            word-break: break-word;
            max-width: 100%;
            line-height: 1.3;
        }

        .file-sidebar {
            width: 180px;
            border-right: 1px solid var(--glass);
            padding: 12px;
            flex-shrink: 0;
        }

        .sidebar-section {
            margin-bottom: 20px;
        }

        .sidebar-title {
            font-size: 0.7rem;
            color: var(--hai);
            text-transform: uppercase;
            letter-spacing: 0.1em;
            margin-bottom: 8px;
            padding-left: 8px;
        }

        .sidebar-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 0.85rem;
            transition: all 0.15s ease;
        }

        .sidebar-item:hover {
            background: var(--glass);
        }

        .sidebar-item.active {
            background: rgba(212, 168, 83, 0.15);
            color: var(--kin);
        }

        /* Text Editor */
        .text-editor {
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        .editor-toolbar {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            border-bottom: 1px solid var(--glass);
            background: rgba(0,0,0,0.2);
        }

        .editor-btn {
            padding: 6px 12px;
            background: var(--glass);
            border: none;
            border-radius: 6px;
            color: var(--shiro);
            cursor: pointer;
            font-size: 0.8rem;
            font-family: inherit;
            transition: all 0.15s ease;
        }

        .editor-btn:hover {
            background: rgba(212, 168, 83, 0.2);
        }

        .editor-container {
            flex: 1;
            display: flex;
            overflow: hidden;
        }

        .line-numbers {
            padding: 16px 12px;
            background: rgba(0,0,0,0.3);
            color: var(--hai);
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.85rem;
            line-height: 1.6;
            text-align: right;
            user-select: none;
            overflow: hidden;
        }

        .editor-textarea {
            flex: 1;
            padding: 16px;
            background: transparent;
            border: none;
            color: var(--shiro);
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.85rem;
            line-height: 1.6;
            resize: none;
            outline: none;
        }

        /* Browser */
        .browser-container {
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        .browser-toolbar {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 16px;
            border-bottom: 1px solid var(--glass);
        }

        .browser-nav-btn {
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            cursor: pointer;
            color: var(--shiro);
            transition: all 0.15s ease;
        }

        .browser-nav-btn:hover {
            background: var(--glass);
        }

        .browser-url {
            flex: 1;
            background: var(--kuro);
            border: 1px solid var(--glass);
            border-radius: 20px;
            padding: 8px 16px;
            color: var(--shiro);
            font-size: 0.85rem;
            outline: none;
        }

        .browser-url:focus {
            border-color: var(--kin);
        }

        .browser-frame {
            flex: 1;
            border: none;
            background: white;
        }

        /* Drawing Board */
        .drawing-board {
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        .drawing-toolbar {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            border-bottom: 1px solid var(--glass);
            flex-wrap: wrap;
        }

        .drawing-tool {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            cursor: pointer;
            color: var(--hai);
            transition: all 0.15s ease;
        }

        .drawing-tool:hover {
            background: var(--glass);
            color: var(--shiro);
        }

        .drawing-tool.active {
            background: var(--kin);
            color: var(--kuro);
        }

        .drawing-color-picker {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            border: 3px solid var(--glass);
            cursor: pointer;
            overflow: hidden;
        }

        .drawing-color-picker input {
            width: 100%;
            height: 100%;
            border: none;
            cursor: pointer;
        }

        .drawing-size-slider {
            width: 100px;
        }

        .drawing-canvas-container {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            background: repeating-conic-gradient(#2a2a2c 0% 25%, #252527 0% 50%) 50% / 20px 20px;
            overflow: auto;
            padding: 20px;
        }

        .drawing-canvas {
            background: white;
            box-shadow: 0 10px 40px rgba(0,0,0,0.3);
            cursor: crosshair;
        }

        /* Media Player */
        .media-player {
            height: 100%;
            display: flex;
            flex-direction: column;
            padding: 20px;
        }

        .media-screen {
            flex: 1;
            background: var(--kuro);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 16px;
            overflow: hidden;
        }

        .media-screen video,
        .media-screen audio {
            max-width: 100%;
            max-height: 100%;
        }

        .media-controls {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .media-progress {
            width: 100%;
            height: 4px;
            background: var(--glass);
            border-radius: 2px;
            cursor: pointer;
        }

        .media-progress-bar {
            height: 100%;
            background: var(--kin);
            border-radius: 2px;
            width: 0%;
        }

        .media-buttons {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 20px;
        }

        .media-btn {
            width: 44px;
            height: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            cursor: pointer;
            color: var(--shiro);
            transition: all 0.15s ease;
            font-size: 1.1rem;
        }

        .media-btn:hover {
            background: var(--glass);
        }

        .media-btn.play {
            width: 56px;
            height: 56px;
            background: var(--kin);
            color: var(--kuro);
        }

        .media-btn.play:hover {
            background: #e0b963;
        }

        /* Calculator */
        .calculator {
            height: 100%;
            display: flex;
            flex-direction: column;
            padding: 16px;
        }

        .calc-display {
            background: var(--kuro);
            border-radius: 12px;
            padding: 20px;
            text-align: right;
            margin-bottom: 16px;
            min-height: 100px;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
        }

        .calc-expression {
            font-size: 0.9rem;
            color: var(--hai);
            margin-bottom: 8px;
            min-height: 1.2rem;
        }

        .calc-result {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2.5rem;
            font-weight: 300;
            color: var(--shiro);
            word-break: break-all;
        }

        .calc-buttons {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
            flex: 1;
        }

        .calc-btn {
            border: none;

        // ============================================
        // DRAWING BOARD
        // ============================================

        function initDrawingBoard(windowData, fileInfo) {
            const { contentEl, id } = windowData;
            let isDrawing = false;
            let currentTool = 'brush';
            let currentColor = '#000000';
            let brushSize = 5;
            let lastX = 0;
            let lastY = 0;

            contentEl.innerHTML = `
                <div class="drawing-board">
                    <div class="drawing-toolbar">
                        <div class="drawing-tool active" data-tool="brush" id="tool-brush-${id}"><i class="fa-solid fa-paintbrush"></i></div>
                        <div class="drawing-tool" data-tool="eraser" id="tool-eraser-${id}"><i class="fa-solid fa-eraser"></i></div>
                        <div class="drawing-tool" data-tool="fill" id="tool-fill-${id}"><i class="fa-solid fa-fill-drip"></i></div>
                        <div style="width:1px;height:24px;background:var(--glass)"></div>
                        <div class="drawing-color-picker" id="color-picker-${id}">
                            <input type="color" value="#000000" id="color-input-${id}">
                        </div>
                        <input type="range" class="drawing-size-slider" id="size-slider-${id}" min="1" max="50" value="5">
                        <span style="font-size:0.8rem;color:var(--hai)" id="size-display-${id}">5px</span>
                        <span style="flex:1"></span>
                        <button class="editor-btn" id="draw-clear-${id}"><i class="fa-solid fa-trash"></i> Clear</button>
                        <button class="editor-btn" id="draw-save-${id}"><i class="fa-solid fa-floppy-disk"></i> Save</button>
                    </div>
                    <div class="drawing-canvas-container">
                        <canvas class="drawing-canvas" id="canvas-${id}" width="600" height="400"></canvas>
                    </div>
                </div>
            `;

            const canvas = contentEl.querySelector(`#canvas-${id}`);
            const ctx = canvas.getContext('2d');
            
            // Set white background
            ctx.fillStyle = 'white';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Tool selection
            contentEl.querySelectorAll('.drawing-tool').forEach(tool => {
                tool.addEventListener('click', () => {
                    contentEl.querySelectorAll('.drawing-tool').forEach(t => t.classList.remove('active'));
                    tool.classList.add('active');
                    currentTool = tool.dataset.tool;
                });
            });

            // Color picker
            const colorInput = contentEl.querySelector(`#color-input-${id}`);
            colorInput.addEventListener('input', (e) => {
                currentColor = e.target.value;
            });

            // Size slider
            const sizeSlider = contentEl.querySelector(`#size-slider-${id}`);
            const sizeDisplay = contentEl.querySelector(`#size-display-${id}`);
            sizeSlider.addEventListener('input', (e) => {
                brushSize = parseInt(e.target.value);
                sizeDisplay.textContent = brushSize + 'px';
            });

            // Clear canvas
            contentEl.querySelector(`#draw-clear-${id}`).addEventListener('click', () => {
                if (confirm('Clear canvas?')) {
                    ctx.fillStyle = 'white';
                    ctx.fillRect(0, 0, canvas.width, canvas.height);
                }
            });

            // Save canvas
            contentEl.querySelector(`#draw-save-${id}`).addEventListener('click', async () => {
                const name = await showModal('Save Drawing', 'drawing.png');
                if (!name) return;

                try {
                    const dataUrl = canvas.toDataURL('image/png');
                    const base64Data = dataUrl.split(',')[1];
                    const binaryString = atob(base64Data);
                    const bytes = new Uint8Array(binaryString.length);
                    for (let i = 0; i < binaryString.length; i++) {
                        bytes[i] = binaryString.charCodeAt(i);
                    }
                    
                    await writeFile(`/home/user/Pictures/${name}`, Buffer.from(bytes));
                    showToast('Drawing saved');
                    refreshFileExplorers();
                } catch (err) {
                    showToast('Failed to save drawing', 'error');
                }
            });

            // Drawing functions
            const getCanvasCoords = (e) => {
                const rect = canvas.getBoundingClientRect();
                const scaleX = canvas.width / rect.width;
                const scaleY = canvas.height / rect.height;
                
                if (e.touches) {
                    return {
                        x: (e.touches[0].clientX - rect.left) * scaleX,
                        y: (e.touches[0].clientY - rect.top) * scaleY
                    };
                }
                return {
                    x: (e.clientX - rect.left) * scaleX,
                    y: (e.clientY - rect.top) * scaleY
                };
            };

            const startDrawing = (e) => {
                isDrawing = true;
                const coords = getCanvasCoords(e);
                lastX = coords.x;
                lastY = coords.y;

                if (currentTool === 'fill') {
                    ctx.fillStyle = currentColor;
                    ctx.fillRect(0, 0, canvas.width, canvas.height);
                }
            };

            const draw = (e) => {
                if (!isDrawing || currentTool === 'fill') return;
                e.preventDefault();

                const coords = getCanvasCoords(e);

                ctx.beginPath();
                ctx.moveTo(lastX, lastY);
                ctx.lineTo(coords.x, coords.y);
                ctx.strokeStyle = currentTool === 'eraser' ? 'white' : currentColor;
                ctx.lineWidth = brushSize;
                ctx.lineCap = 'round';
                ctx.lineJoin = 'round';
                ctx.stroke();

                lastX = coords.x;
                lastY = coords.y;
            };

            const stopDrawing = () => {
                isDrawing = false;
            };

            // Mouse events
            canvas.addEventListener('mousedown', startDrawing);
            canvas.addEventListener('mousemove', draw);
            canvas.addEventListener('mouseup', stopDrawing);
            canvas.addEventListener('mouseout', stopDrawing);

            // Touch events
            canvas.addEventListener('touchstart', startDrawing);
            canvas.addEventListener('touchmove', draw);
            canvas.addEventListener('touchend', stopDrawing);
        }


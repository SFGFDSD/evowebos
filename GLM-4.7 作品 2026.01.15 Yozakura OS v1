        async function loadDirectory(windowId, path) {
            const grid = document.getElementById(`file-grid-${windowId}`);
            const pathInput = document.getElementById(`file-path-${windowId}`);
            if (!grid || !pathInput) return;

            const explorer = fileExplorers.find(e => e.windowId === windowId);
            if (explorer) explorer.path = path;

            pathInput.value = path;
            grid.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:40px;color:var(--hai)"><i class="fa-solid fa-spinner fa-spin"></i> Loading...</div>';

            try {
                const entries = await readdir(path);
                grid.innerHTML = '';

                if (entries.length === 0) {
                    grid.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:40px;color:var(--hai)">This folder is empty</div>';
                    return;
                }

                for (const name of entries) {
                    const fullPath = pathJoin(path, name);
                    try {
                        const stats = await stat(fullPath);
                        const isDir = stats.isDirectory();
                        const ext = name.split('.').pop().toLowerCase();
                        
                        let icon = 'fa-file';
                        if (isDir) icon = 'fa-folder';
                        else if (['jpg', 'jpeg', 'png', 'gif', 'svg', 'webp'].includes(ext)) icon = 'fa-file-image';
                        else if (['txt', 'md', 'js', 'html', 'css', 'json'].includes(ext)) icon = 'fa-file-code';
                        else if (['zip', 'tar', 'gz', 'rar'].includes(ext)) icon = 'fa-file-zipper';
                        else if (['mp3', 'wav', 'ogg', 'flac'].includes(ext)) icon = 'fa-file-audio';
                        else if (['mp4', 'webm', 'mov', 'avi'].includes(ext)) icon = 'fa-file-video';

                        const item = document.createElement('div');
                        item.className = 'file-item';
                        item.dataset.path = fullPath;
                        item.dataset.name = name;
                        item.dataset.type = isDir ? 'dir' : 'file';
                        item.innerHTML = `
                            <i class="fa-solid ${icon}"></i>
                            <span>${name}</span>
                        `;

                        item.addEventListener('dblclick', () => {
                            if (isDir) {
                                navigateTo(windowId, fullPath);
                            } else {
                                openFile(fullPath, name);
                            }
                        });

                        item.addEventListener('contextmenu', (e) => {
                            e.preventDefault();
                            e.stopPropagation();
                            showFileContextMenu(e.clientX, e.clientY, fullPath, name, isDir);
                        });

                        grid.appendChild(item);
                    } catch (err) {
                        console.error('Error reading file:', fullPath, err);
                    }
                }
            } catch (err) {
                grid.innerHTML = `<div style="grid-column:1/-1;text-align:center;padding:40px;color:var(--aka)">
                    <i class="fa-solid fa-circle-exclamation"></i><br>
                    Error: ${err.message}
                </div>`;
            }
        }


        function initMediaPlayer(windowData, fileInfo) {
            const { contentEl, id } = windowData;
            let currentFile = fileInfo?.file || null;
            let mediaElement = null;

            contentEl.innerHTML = `
                <div class="media-player">
                    <div class="media-screen" id="media-screen-${id}">
                        <div style="text-align:center;color:var(--hai)">
                            <i class="fa-solid fa-film" style="font-size:3rem;margin-bottom:16px"></i>
                            <p>Open a media file to play</p>
                            <button class="editor-btn" id="media-open-${id}" style="margin-top:16px">Browse Files</button>
                        </div>
                    </div>
                    <div class="media-controls">
                        <div class="media-progress" id="media-progress-${id}">
                            <div class="media-progress-bar" id="media-progress-bar-${id}"></div>
                        </div>
                        <div class="media-buttons">
                            <div class="media-btn" id="media-seek-back-${id}"><i class="fa-solid fa-backward"></i></div>
                            <div class="media-btn play" id="media-play-${id}"><i class="fa-solid fa-play" id="media-play-icon-${id}"></i></div>
                            <div class="media-btn" id="media-seek-fwd-${id}"><i class="fa-solid fa-forward"></i></div>
                        </div>
                    </div>
                </div>
            `;

            const screen = contentEl.querySelector(`#media-screen-${id}`);
            const progressBar = contentEl.querySelector(`#media-progress-bar-${id}`);
            const progress = contentEl.querySelector(`#media-progress-${id}`);
            const playIcon = contentEl.querySelector(`#media-play-icon-${id}`);

            const loadMedia = async (filePath) => {
                try {
                    const data = await readFile(filePath);
                    const ext = pathBasename(filePath).split('.').pop().toLowerCase();
                    const mimeType = ext === 'mp3' ? 'audio/mpeg' : ext === 'wav' ? 'audio/wav' : ext === 'ogg' ? 'audio/ogg' : 'video/mp4';
                    const blob = new Blob([data], { type: mimeType });
                    const url = URL.createObjectURL(blob);

                    screen.innerHTML = '';
                    
                    if (['mp3', 'wav', 'ogg', 'flac'].includes(ext)) {
                        mediaElement = document.createElement('audio');
                        mediaElement.style.width = '100%';
                    } else {
                        mediaElement = document.createElement('video');
                        mediaElement.style.width = '100%';
                        mediaElement.style.height = '100%';
                    }
                    
                    mediaElement.src = url;
                    mediaElement.controls = true;
                    screen.appendChild(mediaElement);

                    mediaElement.addEventListener('timeupdate', () => {
                        if (mediaElement.duration) {
                            progressBar.style.width = (mediaElement.currentTime / mediaElement.duration * 100) + '%';
                        }
                    });

                    mediaElement.addEventListener('ended', () => {
                        playIcon.className = 'fa-solid fa-play';
                    });

                    currentFile = filePath;
                } catch (err) {
                    showToast('Failed to load media', 'error');
                }
            };

            contentEl.querySelector(`#media-open-${id}`).addEventListener('click', () => {
                createWindow('files', 'Select Media File', { path: '/home/user' });
            });

            contentEl.querySelector(`#media-play-${id}`).addEventListener('click', () => {
                if (!mediaElement) return;
                
                if (mediaElement.paused) {
                    mediaElement.play();
                    playIcon.className = 'fa-solid fa-pause';
                } else {
                    mediaElement.pause();
                    playIcon.className = 'fa-solid fa-play';
                }
            });

            contentEl.querySelector(`#media-seek-back-${id}`).addEventListener('click', () => {
                if (mediaElement) mediaElement.currentTime -= 10;
            });

            contentEl.querySelector(`#media-seek-fwd-${id}`).addEventListener('click', () => {
                if (mediaElement) mediaElement.currentTime += 10;
            });

            progress.addEventListener('click', (e) => {
                if (!mediaElement) return;
                const rect = progress.getBoundingClientRect();
                const percent = (e.clientX - rect.left) / rect.width;
                mediaElement.currentTime = percent * mediaElement.duration;
            });

            // Load file if provided
            if (fileInfo?.file) {
                loadMedia(fileInfo.file);
            }
        }

        // ============================================
        // CALCULATOR
        // ============================================

        function initCalculator(windowData) {
            const { contentEl, id } = windowData;
            let expression = '';
            let lastResult = '';

            contentEl.innerHTML = `
                <div class="calculator">
                    <div class="calc-display">
                        <div class="calc-expression" id="calc-expression-${id}"></div>
                        <div class="calc-result" id="calc-result-${id}">0</div>
                    </div>
                    <div class="calc-buttons" id="calc-buttons-${id}"></div>
                </div>
            `;

            const buttons = contentEl.querySelector(`#calc-buttons-${id}`);
            const expressionEl = contentEl.querySelector(`#calc-expression-${id}`);
            const resultEl = contentEl.querySelector(`#calc-result-${id}`);

            const buttonConfig = [
                { label: 'C', type: 'clear' },
                { label: '±', type: 'operator' },
                { label: '%', type: 'operator' },
                { label: '÷', type: 'operator' },
                { label: '7', type: 'number' },
                { label: '8', type: 'number' },
                { label: '9', type: 'number' },
                { label: '×', type: 'operator' },
                { label: '4', type: 'number' },
                { label: '5', type: 'number' },
                { label: '6', type: 'number' },
                { label: '−', type: 'operator' },
                { label: '1', type: 'number' },
                { label: '2', type: 'number' },
                { label: '3', type: 'number' },
                { label: '+', type: 'operator' },
                { label: '0', type: 'number', style: 'grid-column:span 2' },
                { label: '.', type: 'number' },
                { label: '=', type: 'equals' }
            ];

            buttonConfig.forEach(btn => {
                const button = document.createElement('button');
                button.className = `calc-btn ${btn.type}`;
                button.textContent = btn.label;
                if (btn.style) button.style.cssText = btn.style;
                buttons.appendChild(button);

                button.addEventListener('click', () => {
                    handleInput(btn.label, btn.type);
                });
            });

            function handleInput(label, type) {
                switch (type) {
                    case 'number':
                        if (expression === '' && lastResult !== '') {
                            expression = label;
                            lastResult = '';
                        } else {
                            expression += label;
                        }
                        break;
                    case 'operator':
                        if (label === '±') {
                            if (expression) {
                                if (expression.startsWith('-')) {
                                    expression = expression.substring(1);
                                } else {
                                    expression = '-' + expression;
                                }
                            }
                        } else if (label === '%') {
                            expression = '(' + expression + ')/100';
                        } else {
                            const op = label === '×' ? '*' : label === '÷' ? '/' : label === '−' ? '-' : '+';
                            expression += op;
                        }
                        break;
                    case 'clear':
                        expression = '';
                        lastResult = '';
                        resultEl.textContent = '0';
                        expressionEl.textContent = '';
                        return;
                    case 'equals':
                        try {
                            const result = eval(expression);
                            lastResult = result.toString();
                            expressionEl.textContent = expression + ' =';
                            resultEl.textContent = lastResult;
                            expression = '';
                            return;
                        } catch (err) {
                            resultEl.textContent = 'Error';
                            expression = '';
                            return;
                        }
                }

                // Update display
                if (expression) {
                    const displayExpr = expression.replace(/\*/g, '×').replace(/\//g, '÷');
                    expressionEl.textContent = displayExpr;
                    
                    try {
                        const preview = eval(expression);
                        if (isFinite(preview)) {
                            resultEl.textContent = preview.toString().substring(0, 12);
                        }
                    } catch {
                        // Keep last result
                    }
                }
            }

            // Keyboard support
            document.addEventListener('keydown', (e) => {
                if (!document.getElementById(`calc-buttons-${id}`)) return;
                
                const key = e.key;
                if (/[0-9]/.test(key)) handleInput(key, 'number');
                else if (key === '+') handleInput('+', 'operator');
                else if (key === '-') handleInput('−', 'operator');
                else if (key === '*') handleInput('×', 'operator');
                else if (key === '/') handleInput('÷', 'operator');
                else if (key === '.') handleInput('.', 'number');
                else if (key === 'Enter' || key === '=') handleInput('=', 'equals');
                else if (key === 'Escape' || key === 'c' || key === 'C') handleInput('C', 'clear');
                else if (key === '%') handleInput('%', 'operator');
            });
        }


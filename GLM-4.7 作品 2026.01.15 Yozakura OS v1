        let clipboard = null;

        async function copyFile(path) {
            try {
                const data = await readFile(path);
                clipboard = { path, data };
                showToast('Copied to clipboard');
            } catch (err) {
                showToast('Failed to copy', 'error');
            }
        }

        async function pasteFile(targetPath) {
            if (!clipboard) {
                showToast('Nothing to paste', 'error');
                return;
            }
            try {
                const newName = pathBasename(clipboard.path);
                await writeFile(`${targetPath}/${newName}`, clipboard.data);
                showToast(`Pasted: ${newName}`);
                refreshFileExplorers();
            } catch (err) {
                showToast('Failed to paste', 'error');
            }
        }

        async function deleteFile(path, name) {
            try {
                const stats = await stat(path);
                if (stats.isDirectory()) {
                    await rmdir(path);
                } else {
                    await unlink(path);
                }
                showToast(`Deleted: ${name}`);
                refreshFileExplorers();
            } catch (err) {
                showToast('Failed to delete', 'error');
            }
        }

        async function extractZip(zipPath, targetDir) {
            try {
                const zipData = await readFile(zipPath);
                const blob = new Blob([zipData]);
                const zip = await JSZip.loadAsync(blob);

                for (const [relativePath, file] of Object.entries(zip.files)) {
                    if (file.dir) {
                        await mkdir(`${targetDir}/${relativePath}`);
                    } else {
                        const content = await file.async('arraybuffer');
                        await writeFile(`${targetDir}/${relativePath}`, Buffer.from(content));
                    }
                }

                showToast('Archive extracted successfully');
                refreshFileExplorers();
            } catch (err) {
                showToast('Failed to extract archive', 'error');
                console.error(err);
            }
        }

        function navigateToFileExplorer(path) {
            // Find first file explorer and navigate
            if (fileExplorers.length > 0) {
                navigateTo(fileExplorers[0].windowId, path);
                focusWindow(fileExplorers[0].windowId);
            } else {
                createWindow('files', 'Files', { path });
            }
        }

        function refreshFileExplorers() {
            fileExplorers.forEach(explorer => {
                loadDirectory(explorer.windowId, explorer.path);
            });
        }

        // ============================================
        // OPEN FILES
        // ============================================

        async function openFile(path, name) {
            const ext = name.split('.').pop().toLowerCase();

            try {
                if (['txt', 'md', 'js', 'html', 'css', 'json', 'xml', 'py', 'java', 'c', 'cpp', 'h'].includes(ext)) {
                    const content = await readFile(path, 'utf8');
                    createWindow('editor', name, { file: path, content: content.toString() });
                } else if (['png', 'jpg', 'jpeg', 'gif', 'svg', 'webp'].includes(ext)) {
                    const data = await readFile(path);
                    const blob = new Blob([data], { type: 'image/png' });
                    const url = URL.createObjectURL(blob);
                    
                    // Create a simple image viewer
                    const windowData = createWindow('browser', name, { url: 'about:blank' });
                    setTimeout(() => {
                        const frame = windowData.contentEl.querySelector('iframe');
                        if (frame) {
                            frame.srcdoc = `
                                <!DOCTYPE html>
                                <html>
                                <head>
                                    <style>
                                        body { margin:0; display:flex; align-items:center; justify-content:center; min-height:100vh; background:#1a1a1c; }
                                        img { max-width:100%; max-height:100vh; object-fit:contain; }
                                    </style>
                                </head>
                                <body><img src="${url}" alt="${name}"></body>
                                </html>
                            `;
                        }
                    }, 100);
                } else if (['mp3', 'wav', 'ogg', 'flac'].includes(ext)) {
                    createWindow('media', name, { file: path, type: 'audio' });
                } else if (['mp4', 'webm', 'mov'].includes(ext)) {
                    createWindow('media', name, { file: path, type: 'video' });
                } else if (['zip', 'tar', 'gz'].includes(ext)) {
                    if (confirm('Extract this archive to Downloads?')) {
                        extractZip(path, '/home/user/Downloads');
                    }
                } else {
                    showToast(`Cannot open file type: .${ext}`, 'error');
                }
            } catch (err) {
                showToast('Failed to open file', 'error');
                console.error(err);
            }
        }

        // ============================================
        // TEXT EDITOR
        // ============================================

        function initTextEditor(windowData, fileInfo) {
            const { contentEl, id } = windowData;
            let filePath = typeof fileInfo === 'string' ? fileInfo : (fileInfo?.file || null);
            let content = typeof fileInfo === 'object' && fileInfo?.content ? fileInfo.content : '';
            let isModified = false;

            contentEl.innerHTML = `
                <div class="text-editor">
                    <div class="editor-toolbar">
                        <button class="editor-btn" id="editor-save-${id}"><i class="fa-solid fa-floppy-disk"></i> Save</button>
                        <button class="editor-btn" id="editor-new-${id}"><i class="fa-solid fa-file-circle-plus"></i> New</button>
                        <span style="flex:1"></span>
                        <span id="editor-status-${id}" style="font-size:0.8rem;color:var(--hai)">Untitled</span>
                    </div>
                    <div class="editor-container">
                        <div class="line-numbers" id="line-numbers-${id}">1</div>
                        <textarea class="editor-textarea" id="editor-textarea-${id}" spellcheck="false">${escapeHtml(content)}</textarea>
                    </div>
                </div>
            `;

            const textarea = contentEl.querySelector(`#editor-textarea-${id}`);
            const lineNumbers = contentEl.querySelector(`#line-numbers-${id}`);
            const status = contentEl.querySelector(`#editor-status-${id}`);

            if (filePath) {
                status.textContent = pathBasename(filePath);
            }

            const updateLineNumbers = () => {
                const lines = textarea.value.split('\n').length;
                lineNumbers.innerHTML = Array.from({ length: lines }, (_, i) => i + 1).join('<br>');
            };

            textarea.addEventListener('input', () => {
                updateLineNumbers();
                isModified = true;
                status.textContent = (filePath ? pathBasename(filePath) : 'Untitled') + ' *';
            });

            textarea.addEventListener('scroll', () => {
                lineNumbers.scrollTop = textarea.scrollTop;
            });

            textarea.addEventListener('keydown', (e) => {
                if (e.key === 'Tab') {
                    e.preventDefault();
                    const start = textarea.selectionStart;
                    const end = textarea.selectionEnd;
                    textarea.value = textarea.value.substring(0, start) + '    ' + textarea.value.substring(end);
                    textarea.selectionStart = textarea.selectionEnd = start + 4;
                    updateLineNumbers();
                }
            });

            contentEl.querySelector(`#editor-save-${id}`).addEventListener('click', async () => {
                if (!filePath) {
                    const name = await showModal('Save As', 'untitled.txt');
                    if (!name) return;
                    filePath = `/home/user/Documents/${name}`;
                }
                
                try {
                    await writeFile(filePath, textarea.value);
                    isModified = false;
                    status.textContent = pathBasename(filePath);
                    showToast('File saved');
                } catch (err) {
                    showToast('Failed to save file', 'error');
                }
            });

            contentEl.querySelector(`#editor-new-${id}`).addEventListener('click', () => {
                if (isModified && !confirm('Discard unsaved changes?')) return;
                filePath = null;
                textarea.value = '';
                isModified = false;
                status.textContent = 'Untitled';
                updateLineNumbers();
            });

            updateLineNumbers();
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }


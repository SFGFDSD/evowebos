        function showContextMenu(x, y, context, extraItems = []) {
            const menu = document.getElementById('context-menu');
            menu.innerHTML = '';

            const baseItems = [
                { icon: 'fa-arrows-rotate', label: 'Refresh', action: () => location.reload() },
                { divider: true },
                { icon: 'fa-folder-plus', label: 'New Folder', action: () => showNewFolderModal() },
                { icon: 'fa-file-circle-plus', label: 'New File', action: () => showNewFileModal() },
                { divider: true },
                { icon: 'fa-image', label: 'Change Wallpaper', action: () => showWallpaperPicker() },
                { icon: 'fa-upload', label: 'Import Files', action: () => document.getElementById('file-import-input').click() },
                { icon: 'fa-expand', label: 'Toggle Fullscreen', action: () => toggleFullscreen() }
            ];

            [...baseItems, ...extraItems].forEach(item => {
                if (item.divider) {
                    menu.appendChild(document.createElement('div')).className = 'context-divider';
                } else {
                    const menuItem = document.createElement('div');
                    menuItem.className = 'context-item';
                    menuItem.innerHTML = `<i class="fa-solid ${item.icon}"></i><span>${item.label}</span>`;
                    menuItem.addEventListener('click', () => {
                        item.action();
                        menu.classList.remove('open');
                    });
                    menu.appendChild(menuItem);
                }
            });

            // Position menu
            menu.style.left = x + 'px';
            menu.style.top = y + 'px';
            menu.classList.add('open');

            // Keep menu in viewport
            const rect = menu.getBoundingClientRect();
            if (rect.right > window.innerWidth) {
                menu.style.left = (window.innerWidth - rect.width - 10) + 'px';
            }
            if (rect.bottom > window.innerHeight) {
                menu.style.top = (window.innerHeight - rect.height - 10) + 'px';
            }
        }

        function toggleFullscreen() {
